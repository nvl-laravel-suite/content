{
    "name": "nvl/content",
    "description": "Schema-driven, translatable content blocks, placements, media references, and headless rendering for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "content",
        "blocks",
        "cms",
        "headless",
        "translations",
        "media"
    ],
    "require": {
        "php": "^8.3",
        "ext-filter": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^13.0",
        "nvl/core": "^5.0",
        "nvl/filterable": "^5.0",
        "nvl/media": "^5.0",
        "nvl/translatable": "^5.0",
        "opis/json-schema": "^2.6",
        "spatie/laravel-data": "^4.23",
        "spatie/typescript-transformer": "^3.3",
        "symfony/html-sanitizer": "^7.4 || ^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nvl/tenancy": "^5.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Content\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Content\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "5.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Content\\Providers\\ContentServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests",
            "/.DS_Store",
            "/**/.DS_Store"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "nvl/tenancy": "Enables enforcing tenant ownership, scoped execution, adoption, and captured tenant queue contexts."
    },
    "conflict": {
        "nvl/tenancy": "<5.0 || >=6.0"
    }
}
