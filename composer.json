{
    "name": "nvl/content",
    "description": "Schema-driven, translatable content blocks, placements, media references, and headless rendering for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "content",
        "blocks",
        "cms",
        "headless",
        "translations",
        "media"
    ],
    "require": {
        "ext-filter": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^13.0",
        "nvl/core": "^7.0",
        "nvl/translatable": "^7.0",
        "opis/json-schema": "^2.6",
        "php": "^8.4",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/html-sanitizer": "^7.4 || ^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nvl/media": "^7.0",
        "nvl/ownership": "^7.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "spatie/laravel-data": "^4.23"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Content\\": "src/",
            "Nvl\\Content\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Content\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "7.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Content\\Providers\\ContentServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests",
            "/.DS_Store",
            "/**/.DS_Store",
            "/.gitattributes",
            "/**/.gitattributes",
            "/.gitignore",
            "/**/.gitignore",
            "/**/.gitkeep",
            ".DS_Store"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "nvl/media": "Enables the explicitly configured Media field and attachment adapter.",
        "nvl/ownership": "Adds optional model-declared ownership, isolation, adoption and captured worker contexts."
    },
    "conflict": {
        "nvl/media": "<7.0 || >=8.0",
        "nvl/ownership": "<7.0 || >=8.0"
    },
    "homepage": "https://github.com/nvl-laravel-suite/content",
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/nvl-laravel-suite/content",
        "docs": "https://github.com/nvl-laravel-suite/content#readme",
        "issues": "https://github.com/nvl-laravel-suite/content/issues",
        "security": "https://github.com/nvl-laravel-suite/content/security/policy"
    }
}
